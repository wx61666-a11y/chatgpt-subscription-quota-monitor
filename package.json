{
  "name": "chatgpt-subscription-quota-monitor",
  "version": "3.0.0",
  "description": "Local macOS ChatGPT subscription quota monitor",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dmg",
    "dist": "electron-builder --mac dmg"
  },
  "build": {
    "appId": "local.chatgpt.subscription-quota-monitor",
    "productName": "ChatGPT Subscription Quota Monitor",
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg"
      ]
    }
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  }
}
